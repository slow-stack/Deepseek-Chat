{
  "name": "dsh-chat-demo",
  "version": "0.1.0",
  "description": "把 chat-demo（DeepSeek API 静态聊天示例）作为 DSH 的一个面板挂起来；会话只存在它自己的浏览器存储里，不写 mneme。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "dist/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}